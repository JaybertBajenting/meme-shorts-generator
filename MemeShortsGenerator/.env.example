# Copy to `.env` (same folder) and fill in. `.env` is gitignored; this template is not.
# Anything here overrides appsettings.json. Blank values are ignored.

# --- ElevenLabs TTS (optional; falls back to the offline Windows voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Facebook Page Reels ---
# See docs/META_SETUP.md. PAGE token, not a user token.
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Instagram Reels ---
# Needs an Instagram Business/Creator account linked to the Page above.
# INSTAGRAM_USER_ID is the Instagram Business account id, NOT the Page id and NOT the @handle.
# The token is normally the same Page access token used for Facebook.
INSTAGRAM_ENABLED=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
